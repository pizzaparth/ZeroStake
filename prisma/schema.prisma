generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  player
  admin
}

enum GameType {
  dice
  limbo
  wheel
  flip
  keno
  diamonds
  plinko
  mines
  hilo
  dragon_tower
  blackjack
  video_poker
  crash
}

enum SeedPairStatus {
  next
  active
  revealed
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  balance      BigInt        @default(100000)
  role         Role          @default(player)
  createdAt    DateTime      @default(now())
  gameSessions GameSession[]
  gameRounds   GameRound[]
  seedPairs    SeedPair[]
}

// One row per resolved bet — stateless games write this immediately;
// stateful games write it once, at the terminal event (loss or cashout).
model GameSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  game           GameType
  betAmount      BigInt
  profit         BigInt
  multiplier     Float
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  outcome        Json
  createdAt      DateTime @default(now())
  // Null for bets settled before seed pairs existed (per-bet throwaway seeds).
  seedPairId     String?
  seedPair       SeedPair? @relation(fields: [seedPairId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

// Server-side storage for an in-progress stateful game's secret data
// (mine positions, dragon positions, dealt cards, deck order, etc).
// Authenticated play uses this instead of the client-visible base64 blob,
// so secrets can't be read or tampered with client-side. Row is deleted
// on terminal resolution (loss or cashout) — no TTL needed.
model GameRound {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  game      GameType
  betAmount BigInt
  payload   Json
  createdAt DateTime  @default(now())
  // Set atomically (guarded UPDATE ... WHERE claimedAt IS NULL) by whichever
  // request wins the race to process this round, so a concurrent duplicate
  // request can't also settle/mutate it. Cleared on release for rounds that
  // continue; the row is deleted outright on terminal resolution.
  claimedAt DateTime?

  @@index([userId])
}

// Per-player provably-fair seed pair. Each user has at most one `active` pair
// (bets resolve against it, nonce increments per bet) and one `next` pair whose
// serverSeedHash is published before the player picks the client seed it will
// be paired with. Rotation reveals the active seed and promotes next. The
// one-per-user rule is enforced by partial unique indexes in the migration.
model SeedPair {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  status         SeedPairStatus
  serverSeed     String
  serverSeedHash String
  // Null while `next`: the player chooses it at rotation.
  clientSeed     String?
  // Next nonce to hand out; a bet uses the value before the increment.
  nonce          Int            @default(0)
  createdAt      DateTime       @default(now())
  activatedAt    DateTime?
  revealedAt     DateTime?
  gameSessions   GameSession[]

  @@index([userId, status])
}

// Single-row settings table — always id = 1
model Settings {
  id                     Int      @id @default(1)
  defaultStartingBalance BigInt   @default(100000)
  updatedAt              DateTime @updatedAt
}
